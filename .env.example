# ==============================================================================
# ColorPixo.Com Environment Variables Configuration (Example Template)
# ==============================================================================
# NOTE: DO NOT commit real secrets, private tokens, or credentials to source control.
# Copy this file to .env.local for local development, or set these variables
# directly in your production hosting dashboard (e.g., Hostinger Cloud / VPS).
# ==============================================================================

# Canonical Application URL
APP_URL=https://colorpixo.com

# Google AdSense Publisher Client ID (Format: ca-pub-XXXXXXXXXXXXXXXX)
# Keep empty or unset until your official AdSense account is approved.
NEXT_PUBLIC_ADSENSE_CLIENT=ca-pub-XXXXXXXXXXXXXXXX

# Google AdSense Specific Slot IDs (Numeric string IDs from your AdSense ad units)
# Leave empty until real ad units are created in Google AdSense.
NEXT_PUBLIC_ADSENSE_SLOT=
NEXT_PUBLIC_ADSENSE_HOME_SLOT=
NEXT_PUBLIC_ADSENSE_PALETTES_SLOT=
NEXT_PUBLIC_ADSENSE_GRADIENTS_SLOT=

# Google Gemini API Key (Server-Side Only)
# Used by /api/ai-palette to generate creative 5-color palettes.
# Never expose this key with NEXT_PUBLIC_ prefix.
GEMINI_API_KEY=your_gemini_api_key

# Resend Email Delivery Service (Server-Side Only)
# Used by /api/contact to deliver user messages directly to your email inbox.
RESEND_API_KEY=your_resend_api_key

# Resend Verified Sender Email Address
RESEND_FROM_EMAIL=contact@colorpixo.com

# Contact Form Destination Inbox
CONTACT_TO_EMAIL=your_email@example.com
